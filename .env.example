# SocialTrust v48 — Base Sepolia (PWA + smart wallet)
# Copy this file to .env.local for local development and fill in your own
# client-side service credentials. Never put wallet private keys or seed phrases here.

VITE_SOCIALTRUST_ADDRESS=0xa0A4a7D6c8d06EcaA084384363D95D77eadF4497
VITE_CONTRACT_ADDRESS=0xa0A4a7D6c8d06EcaA084384363D95D77eadF4497
VITE_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
VITE_PROFILES_ADDRESS=0xC0C80f89d32A1b92D893881bCF48779F06BcAa70

# Public client-side RPC configuration. Use a key restricted to your deployed domain where supported.
VITE_RPC_URL=YOUR_BASE_SEPOLIA_RPC_URL
VITE_CHAIN_ID=84532
VITE_CHAIN_NAME=Base Sepolia

# Required by RainbowKit / WalletConnect. Configure allowed origins/domains in your WalletConnect project.
VITE_WALLETCONNECT_PROJECT_ID=YOUR_WALLETCONNECT_PROJECT_ID

# Canonical origin of the deployed app. Used for WalletConnect metadata and the
# icon shown inside wallet apps during approval. Falls back to window.origin.
# NOTE: passkeys are origin-bound, so a smart account created on a preview URL
# is a DIFFERENT account from one created on production.
VITE_APP_URL=https://app.socialtrust.xyz

# Optional ERC-4337 paymaster. When set, smart-account users pay no gas.
# Restrict the sponsorship policy to VITE_SOCIALTRUST_ADDRESS and VITE_USDC_ADDRESS
# and cap per-user spend, or you are funding arbitrary transactions.
VITE_PAYMASTER_URL=

VITE_USE_MOCKS=false
VITE_DEPLOYMENT_BLOCK=44297620

# The Graph supplies challenges, friends, and recent activity.
VITE_GRAPH_ENABLED=true
VITE_GRAPH_URL=https://api.studio.thegraph.com/query/1756570/socialtrust-base-sepolia/0.1.0
